generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  LEADER
  MEMBER
}
enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}
enum ScheduleType {
  WORSHIP
  TRAINING
  EVENT
}
enum SlideType {
  LYRICS
  SCRIPTURE
  ANNOUNCEMENT
  TEXT
}

model User {
  id                String              @id @default(cuid())
  name              String
  email             String              @unique
  passwordHash      String
  role              UserRole            @default(MEMBER)
  photoUrl          String?
  emailVerifiedAt   DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  verificationCodes EmailVerification[]
  member            Member?
  auditLogs         AuditLog[]
  notifications     Notification[]
  membershipApplication MembershipApplication?
  submittedLineups   WorshipLineup[]
}

model ChurchConfig {
  id             String   @id @default("main")
  name           String   @default("Cornerstone Global Harvest Church")
  logoUrl        String?
  service1Start  String   @default("08:00")
  service1End    String   @default("10:00")
  service2Start  String   @default("10:00")
  service2End    String   @default("12:00")
  updatedAt      DateTime @updatedAt
}

model EmailVerification {
  id         String   @id @default(cuid())
  userId     String
  codeHash   String
  purpose    String   @default("VERIFY_EMAIL")
  pendingEmail String?
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, purpose, expiresAt])
}

model MembershipApplication {
  id         String   @id @default(cuid())
  userId     String   @unique
  firstName  String
  lastName   String
  age        Int?
  instrument String?
  photoUrl   String?
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Ministry {
  id        String     @id @default(cuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  members   Member[]
  trainings Training[]
}

model Member {
  id          String               @id @default(cuid())
  userId      String?              @unique
  ministryId  String?
  firstName   String
  lastName    String
  age         Int?
  photoUrl    String?
  instrument  String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  user        User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  ministry    Ministry?            @relation(fields: [ministryId], references: [id], onDelete: SetNull)
  assignments ServiceAssignment[]
  attendance  Attendance[]
  songCredits SongMusician[]
}

model Song {
  id            String         @id @default(cuid())
  title         String
  artist        String?
  originalKey   String?
  teamKey       String?
  bpm           Int?
  worshipLeader String?
  youtubeUrl    String?
  chordText     String?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  musicians     SongMusician[]
  files         ChordFile[]
  @@index([title])
  @@index([artist])
}

model SongMusician {
  id       String @id @default(cuid())
  songId   String
  memberId String
  role     String
  song     Song   @relation(fields: [songId], references: [id], onDelete: Cascade)
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  @@unique([songId, memberId, role])
}

model ChordFile {
  id        String   @id @default(cuid())
  songId    String
  fileName  String
  filePath  String
  mimeType  String
  size      Int
  recognizedText String?
  recognizedChords Json?
  createdAt DateTime @default(now())
  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
}

model UploadedAsset {
  id        String   @id @default(cuid())
  filename  String   @unique
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())
  @@index([createdAt])
}

model Schedule {
  id        String       @id @default(cuid())
  title     String
  type      ScheduleType
  startsAt  DateTime
  endsAt    DateTime?
  location  String?
  details   String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  services  Service[]
  training  Training?
  @@index([type, startsAt])
}

model Service {
  id          String              @id @default(cuid())
  scheduleId  String
  name        String
  startsAt    DateTime
  endsAt      DateTime?
  schedule    Schedule            @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  assignments ServiceAssignment[]
}

model ServiceAssignment {
  id        String  @id @default(cuid())
  serviceId String
  memberId  String
  role      String
  slot      Int     @default(1)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  member    Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  @@unique([serviceId, memberId])
  @@index([memberId])
}

model WorshipLineup {
  id          String        @id @default(cuid())
  serviceDate DateTime      @db.Date
  serviceName String
  submittedAt DateTime      @default(now())
  submittedById String
  submittedBy User          @relation(fields: [submittedById], references: [id], onDelete: Cascade)
  songs       LineupSong[]
  @@index([serviceDate, serviceName])
  @@index([submittedById, submittedAt])
}

model LineupSong {
  id       String       @id @default(cuid())
  lineupId String
  title    String
  category String
  url      String
  position Int
  lineup   WorshipLineup @relation(fields: [lineupId], references: [id], onDelete: Cascade)
  @@index([lineupId, category, position])
}

model Training {
  id          String       @id @default(cuid())
  scheduleId  String       @unique
  ministryId  String?
  description String?
  schedule    Schedule     @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  ministry    Ministry?    @relation(fields: [ministryId], references: [id], onDelete: SetNull)
  attendance  Attendance[]
}

model Attendance {
  id         String           @id @default(cuid())
  trainingId String
  memberId   String
  status     AttendanceStatus
  notes      String?
  markedAt   DateTime         @default(now())
  training   Training         @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  member     Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  @@unique([trainingId, memberId])
  @@index([memberId, markedAt])
}

model Presentation {
  id        String   @id @default(cuid())
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  slides    Slide[]
}

model Slide {
  id             String       @id @default(cuid())
  presentationId String
  position       Int
  type           SlideType    @default(TEXT)
  text           String?
  background     String?
  backgroundUrl  String?
  fontFamily     String?
  fontSize       Int?
  textColor      String?
  alignment      String?
  presentation   Presentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  @@unique([presentationId, position])
}

model LinkResource {
  id        String   @id @default(cuid())
  title     String
  url       String
  addedAt   DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  module     String
  recordId   String?
  beforeJson Json?
  afterJson  Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([userId, createdAt])
  @@index([module, action, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  kind      String   @default("GENERAL")
  link      String?
  sourceKey String?
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceKey])
  @@index([userId, readAt, createdAt])
}
